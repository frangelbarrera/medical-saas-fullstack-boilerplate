{
  "name": "medical-saas-fullstack-boilerplate",
  "private": true,
  "version": "2.0.0",
  "description": "Full-Stack Medical SaaS Boilerplate with AI Scribe, EHR, audit trail and privacy-first design.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "tsx services/api/src/server.ts",
    "start": "tsx services/api/src/server.ts",
    "build": "npm run build --workspace @medical/web",
    "preview": "npm run preview --workspace @medical/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:unit": "vitest run packages services/domain",
    "test:integration": "vitest run services/api services/data",
    "test:authorization": "vitest run services/api/test/authorization.test.ts services/api/test/admin.test.ts",
    "test:e2e": "npm run build && npm run e2e:prepare && playwright test",
    "prisma:generate": "prisma generate --schema services/data/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema services/data/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema services/data/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema services/data/prisma/schema.prisma",
    "db:seed": "tsx services/data/src/seed.ts",
    "clean": "rimraf dist apps/web/dist",
    "db:backfill": "tsx services/data/src/backfill.ts",
    "audit:export": "tsx scripts/audit-export.ts",
    "audit:verify": "tsx scripts/audit-verify.ts",
    "phi:reencrypt": "tsx services/data/src/reencrypt.ts",
    "e2e:prepare": "bash scripts/e2e-prepare.sh",
    "e2e:server": "tsx services/api/src/server.ts"
  },
  "overrides": {
    "nanoid": "^3.3.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.15.0",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "^5.22.0",
    "rimraf": "^6.1.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  }
}
