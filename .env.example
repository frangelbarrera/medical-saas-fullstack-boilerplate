# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL). The application must connect as a LIMITED role
# (not the postgres superuser) so that row-level security policies apply.
# Create the role with ops/db/init/01-app-role.sql or docker compose.
DATABASE_URL=postgresql://medical_app:replace_with_db_password@localhost:5432/medical_saas_db?schema=public

# Connection used ONLY for migrations (needs table creation rights).
# Keep it out of the application runtime environment in production.
MIGRATION_DATABASE_URL=postgresql://postgres:replace_with_db_password@localhost:5432/medical_saas_db?schema=public

# Auth secrets - REQUIRED, no defaults. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace_with_64_char_hex_random_value_min_32_chars
# AES-256 key for field-level PHI encryption - REQUIRED, exactly 64 hex chars:
#   openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_char_hex_random_value_exactly_64_chars
# HMAC key for deterministic PHI search indexes - REQUIRED, exactly 64 hex chars:
#   openssl rand -hex 32
PHI_HMAC_KEY=replace_with_64_char_hex_random_value_exactly_64_chars

# Payment provider (provider-neutral). Webhook HMAC secret shared with the
# provider for signature verification. Minimum 16 chars.
PAYMENT_WEBHOOK_SECRET=replace_with_min_16_char_random_secret
PAYMENT_GATEWAY_TOKEN=

# AI integration (server-side only). Leave empty to disable AI features.
GEMINI_API_KEY=
# PHI handling before LLM calls: strip | redact | passthrough
# strip: removes PHI entirely (default, safe without a data processing agreement)
# redact: masks PHI with placeholders
# passthrough: sends PHI as-is (REQUIRES a signed DPA/BAA with the provider)
LLM_PHI_MODE=strip

# Comma-separated list of trusted proxies in front of the app (e.g. "1" for a
# single reverse proxy, or leave empty when exposing the app directly).
TRUST_PROXY=1

# Initial admin bootstrap (used once by the seed / first start, then remove).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me_immediately

# LLM passthrough governance record (AI-001). LLM_PHI_MODE=passthrough is
# FAIL-CLOSED: the server downgrades the mode to "redact" unless ALL of the
# following records are present. Fill them only after the DPA/BAA is signed,
# the provider is approved, the processing location is documented, the
# zero-retention commitment is confirmed and the DPIA is completed.
LLM_DPA_RECORDED=
LLM_PROVIDER_APPROVED=
LLM_DATA_RESIDENCY=
LLM_ZERO_RETENTION=
LLM_DPIA_RECORDED=

# SMART App Launch authorization server (INT-001). When set, the discovery
# document at /.well-known/smart-configuration advertises its authorize/token
# endpoints. Leave empty if no external SMART authorization server exists yet.
SMART_AUTH_SERVER_URL=
